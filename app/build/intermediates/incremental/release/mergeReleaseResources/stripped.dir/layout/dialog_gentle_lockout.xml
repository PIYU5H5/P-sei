<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/launcherBackground"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Smooth concentric breathing animation in background -->
    <com.psei.launcher.ui.BreathingBackdropView
        android:id="@+id/breathingBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Center breathing guidance and daily limit status -->
    <LinearLayout
        android:id="@+id/centerLockoutContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="44dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/tvBreathPhase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.72"
            android:letterSpacing="0.06"
            android:text="Breathe in slowly"
            android:textColor="?attr/secondaryTextColor"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvLockoutTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Daily Limit Reached"
            android:textColor="?attr/primaryTextColor"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLockoutMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.85"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="You've reached your daily limit for this app.\nTake a slow breath, relax, and recharge."
            android:textColor="?attr/secondaryTextColor"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Minimal buttons anchored cleanly at the bottom -->
    <LinearLayout
        android:id="@+id/bottomControlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="16dp"
        android:paddingEnd="28dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/btnStepAway"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/searchBackground"
            android:gravity="center"
            android:text="Step Away"
            android:textColor="?attr/primaryTextColor"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSnoozeEmergency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:text="Emergency +5 Minutes"
            android:textColor="?attr/secondaryTextColor"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progressEmergencyCooldown"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="2dp"
            android:layout_marginTop="2dp"
            android:indeterminate="false"
            android:max="1000"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvExitHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.65"
            android:gravity="center"
            android:text="Swipe up or press Home to exit"
            android:textColor="?attr/secondaryTextColor"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
