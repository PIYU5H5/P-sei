<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.MinimalLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Window performance: eliminate transition jank -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>

        <!-- Custom semantic attributes -->
        <item name="launcherBackground">@color/bg_dark</item>
        <item name="primaryTextColor">@color/text_primary_dark</item>
        <item name="secondaryTextColor">@color/text_secondary_dark</item>
        <item name="searchBackground">@drawable/bg_search_dark</item>
        <item name="itemHighlight">@color/highlight_dark</item>
        <item name="dividerColor">@color/divider_dark</item>
    </style>

    <!-- Pure AMOLED Black Theme -->
    <style name="Theme.MinimalLauncher.Dark" parent="Theme.MinimalLauncher">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="launcherBackground">@color/bg_dark</item>
        <item name="primaryTextColor">@color/text_primary_dark</item>
        <item name="secondaryTextColor">@color/text_secondary_dark</item>
        <item name="searchBackground">@drawable/bg_search_dark</item>
        <item name="itemHighlight">@color/highlight_dark</item>
        <item name="dividerColor">@color/divider_dark</item>
    </style>

    <!-- Clean Light Theme -->
    <style name="Theme.MinimalLauncher.Light" parent="Theme.MinimalLauncher">
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="launcherBackground">@color/bg_light</item>
        <item name="primaryTextColor">@color/text_primary_light</item>
        <item name="secondaryTextColor">@color/text_secondary_light</item>
        <item name="searchBackground">@drawable/bg_search_light</item>
        <item name="itemHighlight">@color/highlight_light</item>
        <item name="dividerColor">@color/divider_light</item>
    </style>

