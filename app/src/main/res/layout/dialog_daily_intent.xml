<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/launcherBackground"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/tvDailyIntentDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/daily_intent_dialog_title"
        android:textColor="?attr/primaryTextColor"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDailyIntentDialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/daily_intent_dialog_subtitle"
        android:textColor="?attr/secondaryTextColor"
        android:textSize="13sp" />

    <!-- FOCUS ITEM 1 -->
    <LinearLayout
        android:id="@+id/layoutIntentRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="1."
            android:textColor="?attr/secondaryTextColor"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDailyIntent1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:background="?attr/searchBackground"
            android:hint="@string/daily_intent_hint"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="2"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="?attr/primaryTextColor"
            android:textColorHint="?attr/secondaryTextColor"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnRemoveIntent1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="✕"
            android:textColor="?attr/secondaryTextColor"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- FOCUS ITEM 2 -->
    <LinearLayout
        android:id="@+id/layoutIntentRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="2."
            android:textColor="?attr/secondaryTextColor"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDailyIntent2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:background="?attr/searchBackground"
            android:hint="@string/daily_intent_hint_2"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="2"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="?attr/primaryTextColor"
            android:textColorHint="?attr/secondaryTextColor"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnRemoveIntent2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="✕"
            android:textColor="?attr/secondaryTextColor"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- FOCUS ITEM 3 -->
    <LinearLayout
        android:id="@+id/layoutIntentRow3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="3."
            android:textColor="?attr/secondaryTextColor"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDailyIntent3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:background="?attr/searchBackground"
            android:hint="@string/daily_intent_hint_3"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="2"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="?attr/primaryTextColor"
            android:textColorHint="?attr/secondaryTextColor"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnRemoveIntent3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="✕"
            android:textColor="?attr/secondaryTextColor"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- ADD ANOTHER FOCUS BUTTON (MAX 3) -->
    <TextView
        android:id="@+id/btnAddFocusItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="?android:attr/selectableItemBackground"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:text="+ Add another focus (1/3)"
        android:textColor="?attr/secondaryTextColor"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- ACTION BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnClearDailyIntent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="@string/daily_intent_clear_all"
            android:textColor="?attr/secondaryTextColor"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnCancelDailyIntent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="@string/cancel"
            android:textColor="?attr/secondaryTextColor"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnSaveDailyIntent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/save"
            android:textColor="?attr/primaryTextColor"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
