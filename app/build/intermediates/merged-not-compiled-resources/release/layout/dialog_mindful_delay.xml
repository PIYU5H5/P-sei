<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mindfulRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/launcherBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Smooth concentric breathing animation in background -->
    <com.psei.launcher.ui.BreathingBackdropView
        android:id="@+id/breathingBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Center breathing guidance and app reflection -->
    <LinearLayout
        android:id="@+id/centerPromptContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="44dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/tvBreathPhase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.72"
            android:letterSpacing="0.06"
            android:text="Breathe in slowly"
            android:textColor="?attr/secondaryTextColor"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvMindfulCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="5"
            android:textColor="?attr/primaryTextColor"
            android:textSize="52sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMindfulTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Pause and relax"
            android:textColor="?attr/primaryTextColor"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMindfulMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.85"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Opening this app.\nTake a slow breath — is this intentional?"
            android:textColor="?attr/secondaryTextColor"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Minimal buttons anchored cleanly at the bottom -->
    <LinearLayout
        android:id="@+id/bottomControlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="16dp"
        android:paddingEnd="28dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/btnCancelMindful"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/searchBackground"
            android:gravity="center"
            android:text="Step Away"
            android:textColor="?attr/primaryTextColor"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnContinueMindful"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="Continue in 5s"
            android:textColor="?attr/secondaryTextColor"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
