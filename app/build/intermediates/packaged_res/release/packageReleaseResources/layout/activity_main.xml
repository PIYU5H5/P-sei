<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/launcherBackground">

    <!-- ================================================================= -->
    <!-- HOME SCREEN VIEW                                                  -->
    <!-- ================================================================= -->
    <RelativeLayout
        android:id="@+id/homeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Clock, Date, Duolingo Streak, and Calendar Events Header -->
        <LinearLayout
            android:id="@+id/clockArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <TextClock
                android:id="@+id/clockTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="?attr/primaryTextColor"
                android:textSize="56sp"
                android:textStyle="bold"
                tools:text="10:42" />

            <!-- Row with Date and Duolingo Streak Widget -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/clockDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:format12Hour="EEEE, MMMM d"
                    android:format24Hour="EEEE, MMMM d"
                    android:textColor="?attr/secondaryTextColor"
                    android:textSize="18sp"
                    tools:text="Friday, November 6" />

                <!-- Duolingo Streak Widget -->
                <LinearLayout
                    android:id="@+id/layoutDuolingoWidget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:id="@+id/ivDuolingoFlame"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Duolingo Streak Flame"
                        android:src="@drawable/ic_flame" />

                    <TextView
                        android:id="@+id/tvDuolingoStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:textColor="?attr/primaryTextColor"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="42" />
                </LinearLayout>
            </LinearLayout>

            <!-- Google Calendar Daily Events Section -->
            <LinearLayout
                android:id="@+id/layoutCalendarContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnConnectCalendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="2dp"
                    android:paddingBottom="4dp"
                    android:text="@string/connect_calendar"
                    android:textColor="?attr/secondaryTextColor"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Container for dynamic today's events -->
                <LinearLayout
                    android:id="@+id/layoutCalendarEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvNoEvents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="@string/no_events_today"
                    android:textColor="?attr/secondaryTextColor"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

        <!-- Vertically Centered Home Slots (0 to 8 user-configurable apps) -->
        <LinearLayout
            android:id="@+id/slotsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- Bottom Row: Bottom-Left Shortcut, Quick Settings Dot, Bottom-Right Shortcut -->
        <LinearLayout
            android:id="@+id/bottomShortcutsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/btnBottomLeft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/default_phone_name"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="•••"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBottomRight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/default_camera_name"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="18sp" />
        </LinearLayout>

    </RelativeLayout>

    <!-- ================================================================= -->
    <!-- APP DRAWER OVERLAY                                                -->
    <!-- In-activity overlay: zero fragment overhead, instant transition  -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/drawerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/launcherBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Search Box Area -->
        <LinearLayout
            android:id="@+id/searchHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/searchBackground"
                android:hint="@string/search_hint"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="?attr/primaryTextColor"
                android:textColorHint="?attr/secondaryTextColor"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnClearSearch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:text="✕"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="20sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Efficient Text-only RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAppDrawer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="vertical" />

            <!-- Empty Search Results View -->
            <TextView
                android:id="@+id/tvEmptyApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/no_apps_found"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

    <!-- ================================================================= -->
    <!-- LOCKOUT (MONK MODE) OVERLAY                                       -->
    <!-- Serene, distraction-free screen: FOCUS, countdown, phone dialer   -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/layoutLockoutMode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:visibility="gone">

        <!-- Top spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Subtitle Header -->
        <TextView
            android:id="@+id/tvLockoutSubhead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.25"
            android:text="@string/lockout_monk_mode"
            android:textColor="#888888"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Big Bold Title -->
        <TextView
            android:id="@+id/tvLockoutTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.15"
            android:text="@string/lockout_focus"
            android:textColor="#FFFFFF"
            android:textSize="46sp"
            android:textStyle="bold" />

        <!-- Countdown Timer -->
        <TextView
            android:id="@+id/tvLockoutCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-light"
            android:textColor="#FFB800"
            android:textSize="50sp"
            android:textStyle="bold"
            tools:text="24:59" />

        <!-- Mindful message -->
        <TextView
            android:id="@+id/tvLockoutMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/lockout_message"
            android:textColor="#888888"
            android:textSize="14sp" />

        <!-- Bottom spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Phone Calls Button -->
        <TextView
            android:id="@+id/btnLockoutPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_lockout_button"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="@string/lockout_phone_calls"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Subtle Emergency Exit Option -->
        <TextView
            android:id="@+id/btnLockoutEmergencyExit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:padding="8dp"
            android:text="@string/lockout_emergency_exit"
            android:textColor="#444444"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>

