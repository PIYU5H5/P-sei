<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/launcherBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="32dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Take a breath..."
        android:textColor="?attr/primaryTextColor"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMindfulCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="5"
        android:textColor="#FFB800"
        android:textSize="44sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMindfulMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Opening Instagram.\nIs this intentional, or just a reflex?"
        android:textColor="?attr/secondaryTextColor"
        android:textSize="14sp" />

    <!-- Button 1: Cancel / Step away (Mindful choice) -->
    <TextView
        android:id="@+id/btnCancelMindful"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        android:background="?attr/searchBackground"
        android:gravity="center"
        android:text="Nevermind (Step Away)"
        android:textColor="?attr/primaryTextColor"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Button 2: Open anyway (Available after countdown) -->
    <TextView
        android:id="@+id/btnContinueMindful"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="?android:attr/selectableItemBackground"
        android:padding="8dp"
        android:text="Continue in 5s..."
        android:textColor="?attr/secondaryTextColor"
        android:textSize="13sp" />

</LinearLayout>

